{%
  layout 'theme' title: "Manifesto"
  , area: "manifesto"
  , description: manifesto.content
  , path: "manifesto"
%}
{% assign home = objects.home %}

<div class="manifesto">
  <h1 class="hero-message mb-16" data-tilt-hero>{{ objects.manifesto.title }}</h1>
  <div class="manifesto-body md w-full max-w-screen-md px-10">
    {{ objects.manifesto.content }}
  </div>
</div>

