{%
  layout 'theme' title: "Page not found"
  , area: "404"
  , description: "There's nothing at this address."
  , path: "404"
  , noindex: true
%}

<div class="build-with-claude">
  <h1 class="hero-message bwc-title mb-8">Page not found.</h1>
  <p class="build-description mb-12">There's nothing at this address. It may have moved, or the link may be wrong.</p>

  <div class="primary-cta-container">
    <a href="/" class="primary-cta" data-umami-event="404-home">Back to home</a>
  </div>

  <p class="bwc-note link-fineprint">
    Looking for something specific? Try the <a href="/docs.html">docs</a> or the <a href="/cli.html">CLI reference</a>.
  </p>
</div>
