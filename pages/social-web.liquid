{%
  layout 'theme' title: social_web.title
  , area: "social-web"
  , description: social_web.description
  , path: "social-web"
%}
{% assign social_web = objects.social_web %}

<div id="header" class="social-web-hero w-full flex flex-col justify-center items-center gap-6 pt-44 relative">
  <h1 class="hero-message" data-tilt-hero>
    <span class="hero-line-1">websites for</span>
    <span class="hero-line-2">the social web</span>
  </h1>
  <p class="sw-tagline">{{ social_web.tagline }}</p>
  {% include "social-web-cta", placement: "top" %}
</div>

{% comment %} The standards this page is about, each linked to its source. {% endcomment %}

<section class="sw-standards">
  <h2 class="sw-standards-heading">{{ social_web.standards_title }}</h2>
  <p class="sw-standards-intro">{{ social_web.standards_intro }}</p>
  <div class="sw-standards-grid">
    {% for standard in social_web.standards %}
      <div class="benefit sw-standard" data-glow>
        <span class="sw-standard-kicker">{{ standard.kicker }}</span>
        <h3 class="sw-standard-name">{{ standard.name }}</h3>
        <p class="sw-standard-blurb">{{ standard.blurb }}</p>
        <div class="sw-standard-links">
          <a
            href="{{ standard.url }}"
            rel="noopener"
            data-rybbit-event="social-web-standard-{{ standard.name | downcase | replace: ' ', '-' }}"
          >
            {{ standard.link_label }}
            <span class="sw-cta-arrow" aria-hidden="true">&rarr;</span>
          </a>
          {% unless standard.extra_url == blank %}
            <a
              href="{{ standard.extra_url }}"
              rel="noopener"
              data-rybbit-event="social-web-standard-{{ standard.name | downcase | replace: ' ', '-' }}-extra"
            >
              {{ standard.extra_label }}
              <span class="sw-cta-arrow" aria-hidden="true">&rarr;</span>
            </a>
          {% endunless %}
        </div>
      </div>
    {% endfor %}
  </div>
</section>

{% comment %}
  How it works. The .product-page wrapper and .product-section grid are the
  homepage tour's, so the copy/frame rhythm matches. Each frame here is a
  diagram rather than an editor mock, drawn at a 560x400 viewBox and scaled by
  the SVG itself, so the callout markers map straight from viewBox coordinates
  to percentages of the frame.
{% endcomment %}

<div class="product-page social-web-page" id="how-it-works">
  {% for section in social_web.sections %}
    <section
      class="product-section {% cycle 'frame-right', 'frame-left' %}"
      data-product-section
      data-section="{{ section.key }}"
    >
      <div class="product-copy">
        <h2 class="section-title">{{ section.title }}</h2>
        <div class="section-content">{{ section.content }}</div>
      </div>
      <div class="product-frame-wrap" data-tilt>
        {% if section.key == "federate" %}
          <div class="sw-frame">
            <div class="sw-frame-glow" aria-hidden="true"></div>
            <svg class="sw-diagram" viewBox="0 0 560 400" role="img" aria-labelledby="sw-d1-title">
              <title id="sw-d1-title">
                Your content is published by Archival to followers on Mastodon, Threads, Bluesky and other ActivityPub servers,
                and their follows, likes, boosts and replies come back.
              </title>
              <defs>
                <marker
                  id="sw1-head"
                  viewBox="0 0 10 10"
                  refX="9"
                  refY="5"
                  markerWidth="7"
                  markerHeight="7"
                  orient="auto"
                >
                  <path d="M0 0 L10 5 L0 10 z" fill="#06d6a0"></path>
                </marker>
                <marker
                  id="sw1-head-back"
                  viewBox="0 0 10 10"
                  refX="9"
                  refY="5"
                  markerWidth="7"
                  markerHeight="7"
                  orient="auto"
                >
                  <path d="M0 0 L10 5 L0 10 z" fill="#118ab2"></path>
                </marker>
              </defs>

              <g data-callout-target="1">
                <rect class="sw-card" x="20" y="52" width="226" height="150" rx="10"></rect>
                <path class="sw-card-head" d="M30 52h206a10 10 0 0 1 10 10v16H20V62a10 10 0 0 1 10-10z"></path>
                <text class="sw-kicker" x="32" y="70">YOUR CONTENT</text>
                <text class="sw-mono sw-dim" x="234" y="70" text-anchor="end">post/hello.toml</text>
                <text class="sw-mono" x="32" y="102">
                  <tspan class="sw-key">title</tspan> = <tspan class="sw-val">"Hello, world"</tspan>
                </text>
                <text class="sw-mono" x="32" y="124">
                  <tspan class="sw-key">published_at</tspan> = <tspan class="sw-val">2026-10-10</tspan>
                </text>
                <text class="sw-mono" x="32" y="146">
                  <tspan class="sw-key">pinned</tspan> = <tspan class="sw-val">true</tspan>
                </text>
                <text class="sw-mono" x="32" y="168">
                  <tspan class="sw-key">body</tspan> = <tspan class="sw-val">"""</tspan>
                </text>
                <rect class="sw-wire" x="32" y="178" width="150" height="5" rx="2.5"></rect>
                <rect class="sw-wire" x="32" y="188" width="100" height="5" rx="2.5"></rect>
                <text class="sw-dim sw-small" x="133" y="229" text-anchor="middle">edit in the editor, or git push</text>
              </g>

              <path class="sw-arrow" d="M246 127 H312" marker-end="url(#sw1-head)"></path>
              <text class="sw-dim sw-small" x="280" y="118" text-anchor="middle">publish</text>

              <g data-callout-target="2">
                <rect class="sw-card" x="314" y="52" width="226" height="150" rx="10"></rect>
                <path class="sw-card-head" d="M324 52h206a10 10 0 0 1 10 10v16H314V62a10 10 0 0 1 10-10z"></path>
                <text class="sw-kicker" x="326" y="70">ARCHIVAL HOSTING</text>
                <text x="326" y="102"><tspan class="sw-check">&#10003;</tspan> WebFinger discovery</text>
                <text x="326" y="124"><tspan class="sw-check">&#10003;</tspan> Actor profile</text>
                <text x="326" y="146"><tspan class="sw-check">&#10003;</tspan> Inbox and outbox</text>
                <text x="326" y="168"><tspan class="sw-check">&#10003;</tspan> Delivery on every deploy</text>
                <text class="sw-mono sw-dim sw-tiny" x="326" y="190">/.well-known/webfinger &middot; /_archival/ap/</text>
                <rect class="sw-pill sw-pill--teal" x="314" y="212" width="226" height="26" rx="13"></rect>
                <text class="sw-mono sw-handle" x="427" y="229" text-anchor="middle">@blog@example.com</text>
              </g>

              <path class="sw-arrow" d="M350 238 V286" marker-end="url(#sw1-head)"></path>
              <text class="sw-dim sw-small" text-anchor="end">
                <tspan x="340" y="258">Create &middot; Update</tspan>
                <tspan x="340" y="272">&middot; Delete</tspan>
              </text>
              <path class="sw-arrow sw-arrow--back" d="M500 288 V240" marker-end="url(#sw1-head-back)"></path>
              <text class="sw-dim sw-small" text-anchor="end">
                <tspan x="490" y="258">Follow &middot; Like</tspan>
                <tspan x="490" y="272">Boost &middot; Reply</tspan>
              </text>

              <g data-callout-target="3">
                <rect class="sw-dashed-box" x="20" y="288" width="520" height="92" rx="10"></rect>
                <text class="sw-kicker" x="32" y="306">FOLLOWED FROM</text>
                <rect class="sw-pill" x="32" y="316" width="160" height="24" rx="12"></rect>
                <text x="112" y="332" text-anchor="middle">Mastodon</text>
                <rect class="sw-pill" x="200" y="316" width="160" height="24" rx="12"></rect>
                <text x="280" y="332" text-anchor="middle">Threads</text>
                <rect class="sw-pill" x="368" y="316" width="160" height="24" rx="12"></rect>
                <text x="448" y="332" text-anchor="middle">Bluesky &middot; via Bridgy Fed</text>
                <rect class="sw-pill" x="32" y="348" width="160" height="24" rx="12"></rect>
                <text x="112" y="364" text-anchor="middle">Misskey</text>
                <rect class="sw-pill" x="200" y="348" width="160" height="24" rx="12"></rect>
                <text x="280" y="364" text-anchor="middle">Micro.blog</text>
                <text class="sw-dim" x="448" y="364" text-anchor="middle">+ hundreds more</text>
              </g>
            </svg>

            <button
              type="button"
              class="callout-marker"
              data-callout="1"
              style="--cx:43.9%;--cy:13%;--i:1;"
              aria-describedby="sw1-1"
            >
              1
            </button>
            <button
              type="button"
              class="callout-marker"
              data-callout="2"
              style="--cx:96.4%;--cy:13%;--i:2;"
              aria-describedby="sw1-2"
            >
              2
            </button>
            <button
              type="button"
              class="callout-marker"
              data-callout="3"
              style="--cx:96.4%;--cy:72%;--i:3;"
              aria-describedby="sw1-3"
            >
              3
            </button>
          </div>

          <ol class="callout-legend">
            <li class="callout-item" data-callout="1" id="sw1-1" style="--i:1;">
              <b>1</b>
              Map a post type's fields once. The content is what you already write.
            </li>
            <li class="callout-item" data-callout="2" id="sw1-2" style="--i:2;">
              <b>2</b>
              Archival serves WebFinger, the actor, inbox and outbox, and delivers each deploy.
            </li>
            <li class="callout-item" data-callout="3" id="sw1-3" style="--i:3;">
              <b>3</b>
              Followed from anything that speaks ActivityPub, and Bluesky through Bridgy Fed.
            </li>
          </ol>
        {% elsif section.key == "webmention" %}
