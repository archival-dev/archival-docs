{%
  layout 'theme' title: social_web.title
  , area: "social-web"
  , description: social_web.description
  , path: "social-web"
%}
{% assign social_web = objects.social_web %}

<div id="header" class="social-web-hero w-full flex flex-col justify-center items-center gap-6 pt-44 relative">
  <h1 class="hero-message" data-tilt-hero>
    <span class="hero-line-1">websites for</span>
    <span class="hero-line-2">the social web</span>
  </h1>
  <p class="sw-tagline">{{ social_web.tagline }}</p>
  {% include "social-web-cta", placement: "top" %}
</div>

{% comment %} The standards this page is about, each linked to its source. {% endcomment %}

<section class="sw-standards">
  <h2 class="sw-standards-heading">{{ social_web.standards_title }}</h2>
  <p class="sw-standards-intro">{{ social_web.standards_intro }}</p>
  <div class="sw-standards-grid">
    {% for standard in social_web.standards %}
      <div class="benefit sw-standard" data-glow>
        <span class="sw-standard-kicker">{{ standard.kicker }}</span>
        <h3 class="sw-standard-name">{{ standard.name }}</h3>
        <p class="sw-standard-blurb">{{ standard.blurb }}</p>
        <div class="sw-standard-links">
          <a
            href="{{ standard.url }}"
            rel="noopener"
            data-rybbit-event="social-web-standard-{{ standard.name | downcase | replace: ' ', '-' }}"
          >
            {{ standard.link_label }}
            <span class="sw-cta-arrow" aria-hidden="true">&rarr;</span>
          </a>
          {% unless standard.extra_url == blank %}
            <a
              href="{{ standard.extra_url }}"
              rel="noopener"
              data-rybbit-event="social-web-standard-{{ standard.name | downcase | replace: ' ', '-' }}-extra"
            >
              {{ standard.extra_label }}
              <span class="sw-cta-arrow" aria-hidden="true">&rarr;</span>
            </a>
          {% endunless %}
        </div>
      </div>
    {% endfor %}
  </div>
</section>

{% comment %}
  How it works. The .product-page wrapper and .product-section grid are the
  homepage tour's, so the copy/frame rhythm matches. Each frame here is a
  diagram rather than an editor mock, two or three boxes and at most one arrow
  each way, drawn at a 560x400 viewBox and scaled by
  the SVG itself, so the callout markers map straight from viewBox coordinates
  to percentages of the frame.
{% endcomment %}

<div class="product-page social-web-page" id="how-it-works">
  {% for section in social_web.sections %}
    <section
      class="product-section {% cycle 'frame-right', 'frame-left' %}"
      data-product-section
      data-section="{{ section.key }}"
    >
      <div class="product-copy">
        <h2 class="section-title">{{ section.title }}</h2>
        <div class="section-content">{{ section.content }}</div>
      </div>
      <div class="product-frame-wrap" data-tilt>
        {% if section.key == "federate" %}
          <div class="sw-frame">
            <div class="sw-frame-glow" aria-hidden="true"></div>
            <svg class="sw-diagram" viewBox="0 0 560 400" role="img" aria-labelledby="sw-d1-title">
              <title id="sw-d1-title">Your site is an account on your own domain. Each deploy delivers its posts to followers on Mastodon, Threads and other ActivityPub servers, and their follows, likes, boosts and replies come back.</title>
              <defs>
                <marker id="sw1-head" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
                  <path d="M0 0 L10 5 L0 10 z" fill="#06d6a0"></path>
                </marker>
                <marker id="sw1-head-back" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
                  <path d="M0 0 L10 5 L0 10 z" fill="#118ab2"></path>
                </marker>
              </defs>

              <g data-callout-target="1">
                <rect class="sw-card" x="150" y="40" width="260" height="110" rx="10"></rect>
                <text class="sw-kicker" x="280" y="68" text-anchor="middle">YOUR SITE</text>
                <rect class="sw-pill sw-pill--teal" x="180" y="82" width="200" height="30" rx="15"></rect>
                <text class="sw-mono sw-handle" x="280" y="102" text-anchor="middle">@blog@example.com</text>
                <text class="sw-dim sw-small" x="280" y="134" text-anchor="middle">your posts, on every deploy</text>
              </g>

              <path class="sw-arrow" d="M230 150 V246" marker-end="url(#sw1-head)"></path>
              <text class="sw-dim sw-small" x="220" y="204" text-anchor="end">posts</text>
              <path class="sw-arrow sw-arrow--back" d="M330 248 V152" marker-end="url(#sw1-head-back)"></path>
              <text class="sw-dim sw-small" x="340" y="204">follows &middot; likes &middot; replies</text>

              <g data-callout-target="2">
                <rect class="sw-dashed-box" x="20" y="250" width="520" height="110" rx="10"></rect>
                <text class="sw-kicker" x="280" y="276" text-anchor="middle">FOLLOWED FROM</text>
                <rect class="sw-pill" x="38" y="292" width="112" height="28" rx="14"></rect>
                <text x="94" y="311" text-anchor="middle">Mastodon</text>
                <rect class="sw-pill" x="162" y="292" width="112" height="28" rx="14"></rect>
                <text x="218" y="311" text-anchor="middle">Threads</text>
                <rect class="sw-pill" x="286" y="292" width="112" height="28" rx="14"></rect>
                <text x="342" y="311" text-anchor="middle">Misskey</text>
                <rect class="sw-pill" x="410" y="292" width="112" height="28" rx="14"></rect>
                <text x="466" y="311" text-anchor="middle">Micro.blog</text>
                <text class="sw-dim sw-small" x="280" y="344" text-anchor="middle">and hundreds more</text>
              </g>
            </svg>

            <button
              type="button"
              class="callout-marker"
              data-callout="1"
              style="--cx:73.2%;--cy:10%;--i:1;"
              aria-describedby="sw1-1"
            >
              1
            </button>
            <button
              type="button"
              class="callout-marker"
              data-callout="2"
              style="--cx:96.4%;--cy:62.5%;--i:2;"
              aria-describedby="sw1-2"
            >
              2
            </button>
          </div>

          <ol class="callout-legend">
            <li class="callout-item" data-callout="1" id="sw1-1" style="--i:1;">
              <b>1</b>
              Map a post type's fields once. Archival serves the account and delivers each deploy.
            </li>
            <li class="callout-item" data-callout="2" id="sw1-2" style="--i:2;">
              <b>2</b>
              Followed from anything that speaks ActivityPub, and what people do there comes back.
            </li>
          </ol>
        {% elsif section.key == "atproto" %}
          <div class="sw-frame">
            <div class="sw-frame-glow" aria-hidden="true"></div>
            <svg class="sw-diagram" viewBox="0 0 560 400" role="img" aria-labelledby="sw-d6-title">
              <title id="sw-d6-title">Your site hosts its own AT Protocol account, whose handle is your domain. Each deploy publishes its posts, which appear on Bluesky, and follows, likes and replies come back.</title>
              <defs>
                <marker id="sw6-head" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
                  <path d="M0 0 L10 5 L0 10 z" fill="#06d6a0"></path>
                </marker>
                <marker id="sw6-head-back" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
                  <path d="M0 0 L10 5 L0 10 z" fill="#118ab2"></path>
                </marker>
              </defs>

              <g data-callout-target="1">
                <rect class="sw-card" x="20" y="110" width="190" height="160" rx="10"></rect>
                <text class="sw-kicker" x="32" y="136">YOUR SITE</text>
                <text class="sw-mono sw-dim" x="32" y="162">post/hello.toml</text>
                <rect class="sw-wire" x="32" y="174" width="150" height="5" rx="2.5"></rect>
                <rect class="sw-wire" x="32" y="186" width="110" height="5" rx="2.5"></rect>
                <rect class="sw-pill sw-pill--teal" x="32" y="216" width="166" height="30" rx="15"></rect>
                <text class="sw-mono sw-handle" x="115" y="236" text-anchor="middle">@example.com</text>
              </g>

              <path class="sw-arrow" d="M210 160 H346" marker-end="url(#sw6-head)"></path>
              <text class="sw-dim sw-small" x="279" y="150" text-anchor="middle">every deploy</text>
              <path class="sw-arrow sw-arrow--back" d="M348 226 H212" marker-end="url(#sw6-head-back)"></path>
              <text class="sw-dim sw-small" x="279" y="246" text-anchor="middle">follows &middot; likes &middot; replies</text>

              <g data-callout-target="2">
                <rect class="sw-card" x="350" y="90" width="190" height="200" rx="10"></rect>
                <text class="sw-kicker" x="362" y="116">BLUESKY</text>
                <circle class="sw-avatar sw-avatar--teal" cx="376" cy="146" r="12"></circle>
                <text class="sw-strong" x="396" y="144">Your site</text>
                <text class="sw-dim sw-tiny" x="396" y="158">@example.com</text>
                <rect class="sw-wire sw-wire--bright" x="362" y="178" width="120" height="6" rx="3"></rect>
                <rect class="sw-wire" x="362" y="192" width="160" height="5" rx="2.5"></rect>
                <rect class="sw-wire" x="362" y="204" width="130" height="5" rx="2.5"></rect>
                <text class="sw-dim sw-small" x="362" y="236">3 replies &middot; 12 likes</text>
                <text class="sw-dim sw-tiny" x="362" y="270">and any AT Protocol app</text>
              </g>
            </svg>

            <button
              type="button"
              class="callout-marker"
              data-callout="1"
              style="--cx:37.5%;--cy:27.5%;--i:1;"
              aria-describedby="sw6-1"
            >
              1
            </button>
            <button
              type="button"
              class="callout-marker"
              data-callout="2"
              style="--cx:96.4%;--cy:22.5%;--i:2;"
              aria-describedby="sw6-2"
            >
              2
            </button>
          </div>

          <ol class="callout-legend">
            <li class="callout-item" data-callout="1" id="sw6-1" style="--i:1;">
              <b>1</b>
              The site hosts its own account. Its handle is your domain, with no bridge in between.
            </li>
            <li class="callout-item" data-callout="2" id="sw6-2" style="--i:2;">
              <b>2</b>
              Posts appear on Bluesky, and what people do with them comes back.
            </li>
          </ol>
        {% elsif section.key == "apps" %}
          <div class="sw-frame">
            <div class="sw-frame-glow" aria-hidden="true"></div>
            <svg class="sw-diagram" viewBox="0 0 560 400" role="img" aria-labelledby="sw-d5-title">
              <title id="sw-d5-title">A Mastodon app signs in with your domain as its server. Once approved in the Archival editor, it reads the account's home timeline and stars, boosts and replies as that account.</title>
              <defs>
                <marker id="sw5-head" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
                  <path d="M0 0 L10 5 L0 10 z" fill="#06d6a0"></path>
                </marker>
                <marker id="sw5-head-back" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
                  <path d="M0 0 L10 5 L0 10 z" fill="#118ab2"></path>
