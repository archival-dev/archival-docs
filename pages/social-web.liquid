                <rect class="sw-wire" x="56" y="158" width="100" height="5" rx="2.5"></rect>
                <line class="sw-divider" x1="56" y1="178" x2="204" y2="178"></line>
                <circle class="sw-avatar sw-avatar--blue" cx="66" cy="204" r="10"></circle>
                <text class="sw-strong sw-small" x="82" y="202">Kai</text>
                <text class="sw-dim sw-tiny" x="82" y="215">@kai@pixelfed.social</text>
                <rect class="sw-wire" x="56" y="228" width="130" height="5" rx="2.5"></rect>
                <line class="sw-divider" x1="56" y1="248" x2="204" y2="248"></line>
                <circle class="sw-avatar sw-avatar--yellow" cx="66" cy="274" r="10"></circle>
                <text class="sw-strong sw-small" x="82" y="272">Sam</text>
                <text class="sw-dim sw-tiny" x="82" y="285">@sam@sams.blog</text>
                <rect class="sw-wire" x="56" y="298" width="120" height="5" rx="2.5"></rect>
                <rect class="sw-wire" x="56" y="308" width="80" height="5" rx="2.5"></rect>
                <text class="sw-dim sw-tiny" x="130" y="376" text-anchor="middle">Ivory &middot; Tusky &middot; Elk &middot; Phanpy</text>
              </g>

              <path class="sw-arrow" d="M220 160 H336" marker-end="url(#sw5-head)"></path>
              <text class="sw-dim sw-small" x="278" y="150" text-anchor="middle">sign in</text>
              <path class="sw-arrow sw-arrow--back" d="M338 226 H222" marker-end="url(#sw5-head-back)"></path>
              <text class="sw-dim sw-small" x="279" y="246" text-anchor="middle">timeline</text>

              <g data-callout-target="2">
                <rect class="sw-card" x="340" y="120" width="200" height="150" rx="10"></rect>
                <text class="sw-kicker" x="352" y="146">YOUR SITE</text>
                <rect class="sw-pill sw-pill--teal" x="352" y="160" width="176" height="30" rx="15"></rect>
                <text class="sw-mono sw-handle" x="440" y="180" text-anchor="middle">@jesse@example.com</text>
                <text class="sw-dim sw-small" x="352" y="222">no password to make</text>
                <text class="sw-dim sw-small" x="352" y="244">star, boost and reply as you</text>
              </g>
            </svg>

            <button
              type="button"
              class="callout-marker"
              data-callout="1"
              style="--cx:39.3%;--cy:10%;--i:1;"
              aria-describedby="sw5-1"
            >
              1
            </button>
            <button
              type="button"
              class="callout-marker"
              data-callout="2"
              style="--cx:96.4%;--cy:30%;--i:2;"
              aria-describedby="sw5-2"
            >
              2
            </button>
          </div>

          <ol class="callout-legend">
            <li class="callout-item" data-callout="1" id="sw5-1" style="--i:1;">
              <b>1</b>
              Add a server in any Mastodon app, and give it your domain.
            </li>
            <li class="callout-item" data-callout="2" id="sw5-2" style="--i:2;">
              <b>2</b>
              Approve it in the Archival editor. The app reads the account's timeline and acts as it.
            </li>
          </ol>
        {% elsif section.key == "webmention" %}
          <div class="sw-frame">
            <div class="sw-frame-glow" aria-hidden="true"></div>
            <svg class="sw-diagram" viewBox="0 0 560 400" role="img" aria-labelledby="sw-d2-title">
              <title id="sw-d2-title">A page on another site links to yours and sends a webmention, which Archival verifies and keeps. When your posts link out, Archival sends a webmention to the other site on deploy.</title>
