                <circle class="sw-avatar sw-avatar--pink" cx="360" cy="198" r="7"></circle>
                <rect class="sw-wire sw-wire--bright" x="374" y="191" width="50" height="5" rx="2.5"></rect>
                <rect class="sw-wire" x="374" y="201" width="140" height="4" rx="2"></rect>
                <circle class="sw-avatar sw-avatar--blue" cx="360" cy="232" r="7"></circle>
