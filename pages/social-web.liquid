                <text x="326" y="134"><tspan class="sw-check">&#10003;</tspan> Link verified</text>
                <text x="326" y="156"><tspan class="sw-check">&#10003;</tspan> Kept as a reply</text>
                <text class="sw-dim sw-small" x="326" y="176">or a like, repost, bookmark or mention</text>
              </g>

              <line class="sw-divider" x1="20" y1="212" x2="540" y2="212"></line>
              <rect class="sw-divider-mask" x="222" y="204" width="116" height="16"></rect>
              <text class="sw-dim sw-tiny" x="280" y="215.5" text-anchor="middle">AND THE OTHER WAY</text>

              <g data-callout-target="4">
                <rect class="sw-card" x="20" y="232" width="226" height="140" rx="10"></rect>
                <path class="sw-card-head" d="M30 232h206a10 10 0 0 1 10 10v16H20v-16a10 10 0 0 1 10-10z"></path>
                <text class="sw-mono sw-dim" x="32" y="250">their-blog.com/notes/42</text>
                <rect class="sw-pill sw-pill--blue" x="32" y="266" width="202" height="22" rx="11"></rect>
                <text class="sw-mono sw-endpoint" x="133" y="281" text-anchor="middle">/webmention</text>
                <text x="32" y="314"><tspan class="sw-check">&#10003;</tspan> Verifies, shows your reply</text>
                <text class="sw-dim sw-small" x="32" y="334">as a comment under their post</text>
              </g>

              <path class="sw-arrow" d="M314 280 H250" marker-end="url(#sw2-head)"></path>
              <text class="sw-dim sw-small" x="280" y="272" text-anchor="middle">webmention</text>
              <path class="sw-arrow sw-arrow--back" d="M246 316 H310" marker-end="url(#sw2-head-back)"></path>
              <text class="sw-dim sw-small" x="280" y="332" text-anchor="middle">verified</text>

              <g data-callout-target="3">
                <rect class="sw-card" x="314" y="232" width="226" height="140" rx="10"></rect>
                <path class="sw-card-head" d="M324 232h206a10 10 0 0 1 10 10v16H314v-16a10 10 0 0 1 10-10z"></path>
                <text class="sw-mono sw-dim" x="326" y="250">post/hello.toml</text>
                <text class="sw-mono" x="326" y="276">
                  <tspan class="sw-key">content</tspan> = <tspan class="sw-val">"""</tspan>
                </text>
                <text class="sw-small" x="326" y="296">Loved <tspan class="sw-link">their-blog.com/notes/42</tspan></text>
                <rect class="sw-wire" x="326" y="306" width="150" height="5" rx="2.5"></rect>
                <text x="326" y="338"><tspan class="sw-check">&#10003;</tspan> Mention sent on deploy</text>
                <text class="sw-dim sw-small" x="326" y="358">Archival serves it as microformats</text>
              </g>
            </svg>

            <button
              type="button"
              class="callout-marker"
              data-callout="1"
              style="--cx:43.9%;--cy:13%;--i:1;"
              aria-describedby="sw2-1"
