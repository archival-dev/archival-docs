              <path class="sw-arrow" d="M190 85 C214 85 210 172 234 172" marker-end="url(#sw3-head)"></path>
              <path class="sw-arrow" d="M190 171 C212 171 212 192 234 192" marker-end="url(#sw3-head)"></path>
