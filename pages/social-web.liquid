        {% elsif section.key == "conversation" %}
          <div class="sw-frame">
            <div class="sw-frame-glow" aria-hidden="true"></div>
            <svg class="sw-diagram" viewBox="0 0 560 400" role="img" aria-labelledby="sw-d3-title">
              <title id="sw-d3-title">A reply from Mastodon, a reply from Bluesky and a webmention from a blog are kept by Archival and shown as one thread under the post on your own site.</title>
