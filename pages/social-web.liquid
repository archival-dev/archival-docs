                  <path d="M0 0 L10 5 L0 10 z" fill="#118ab2"></path>
                </marker>
              </defs>

              <text class="sw-kicker" x="20" y="40">THEIR SITE</text>
              <text class="sw-kicker" x="314" y="40">YOUR SITE</text>

              <g data-callout-target="1">
                <rect class="sw-card" x="20" y="52" width="226" height="140" rx="10"></rect>
                <path class="sw-card-head" d="M30 52h206a10 10 0 0 1 10 10v16H20V62a10 10 0 0 1 10-10z"></path>
                <text class="sw-mono sw-dim" x="32" y="70">their-blog.com/notes/42</text>
                <text class="sw-small" x="32" y="100">Replying to <tspan class="sw-link">example.com/post/hello</tspan></text>
                <rect class="sw-wire" x="32" y="112" width="170" height="5" rx="2.5"></rect>
                <rect class="sw-wire" x="32" y="122" width="120" height="5" rx="2.5"></rect>
                <text class="sw-kicker" x="32" y="150">MICROFORMATS</text>
                <rect class="sw-pill" x="32" y="158" width="58" height="18" rx="9"></rect>
                <text class="sw-mono sw-tiny" x="61" y="170" text-anchor="middle">h-entry</text>
                <rect class="sw-pill" x="96" y="158" width="78" height="18" rx="9"></rect>
                <text class="sw-mono sw-tiny" x="135" y="170" text-anchor="middle">in-reply-to</text>
                <rect class="sw-pill" x="180" y="158" width="54" height="18" rx="9"></rect>
                <text class="sw-mono sw-tiny" x="207" y="170" text-anchor="middle">p-author</text>
              </g>

              <path class="sw-arrow" d="M246 100 H312" marker-end="url(#sw2-head)"></path>
              <text class="sw-dim sw-small" x="280" y="92" text-anchor="middle">webmention</text>
              <path class="sw-arrow sw-arrow--back" d="M314 136 H248" marker-end="url(#sw2-head-back)"></path>
              <text class="sw-dim sw-small" x="280" y="152" text-anchor="middle">verified</text>

              <g data-callout-target="2">
                <rect class="sw-card" x="314" y="52" width="226" height="140" rx="10"></rect>
                <path class="sw-card-head" d="M324 52h206a10 10 0 0 1 10 10v16H314V62a10 10 0 0 1 10-10z"></path>
                <text class="sw-mono sw-dim" x="326" y="70">example.com/post/hello</text>
                <rect class="sw-pill sw-pill--teal" x="326" y="86" width="202" height="22" rx="11"></rect>
