<p class="build-alt">Or build something from scratch</p>

<div class="build-alt-row">
  {% comment %}
    The href names the production editor, which is what a visitor with no JS
    needs; src/build-with-claude.ts repoints it at the editor this build
    targets.
  {% endcomment %}
  <a
    id="build-it-here"
    class="build-alt-cta"
    href="https://editor.archival.dev/new?scratch=1"
    data-rybbit-event="build-it-here"
  >
    <svg
      class="build-alt-mark"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 500 500"
      fill="currentColor"
      aria-hidden="true"
    >
      <path d="M282.333 20.3418C321.663 -17.4266 386.974 -0.122002 402.662 51.786L403.023 53.019L403.035 53.065L403.048 53.1119L403.337 54.1595L403.353 54.2154L497.472 408.188C511.915 462.503 462.119 512.073 407.869 497.385L53.9519 401.56C-0.2976 386.872 -18.2825 318.95 21.5907 279.341L281.404 21.2488L281.48 21.1735L282.258 20.4146L282.296 20.3778L282.333 20.3418ZM270.576 110.762C256.716 105.175 241.78 104.241 231.559 106.105L39.2615 297.129C13.0871 323.13 24.8927 367.717 60.5047 377.359L118.429 393.042C115.509 385.714 113.312 377.796 112.158 369.666C109.097 348.089 113.224 323.395 132.611 304.111L132.617 304.106L299.988 137.842C294.375 124.717 283.491 115.968 270.576 110.762ZM458.414 358.867C454.484 364.368 449.845 369.646 444.435 374.325C427.603 388.882 403.891 397.044 373.727 388.877L145.718 327.143C137.157 338.565 135.028 352.36 136.983 366.145C139.081 380.934 145.748 394.334 152.477 402.261L414.422 473.184C450.034 482.826 482.721 450.285 473.241 414.631L458.414 358.867ZM165.704 306.578L359.303 358.996L307.826 165.397L165.704 306.578ZM378.893 59.8323C369.021 25.1878 325.69 13.4677 299.7 38.4258L299.043 39.0677L256.589 81.2395C264.391 82.3794 272.34 84.4397 279.95 87.5073C300.161 95.6546 319.478 111.583 326.487 138.004L387.161 366.193C405.247 369.241 418.359 363.729 428.034 355.361C438.477 346.329 445.361 333.479 448.811 322.75L379.136 60.7135L378.893 59.8323Z" />
    </svg>
    Build with Archival
