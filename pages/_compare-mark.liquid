{% comment %}
  The icon in front of a comparison cell. mark: yes, no, partly, or for a
  price lower or higher; anything else draws nothing. The label is what a
  screen reader hears in its place.
{% endcomment %}
{% if mark == "yes" %}
  <svg class="lp-mark lp-mark--yes" role="img" aria-label="Yes" viewBox="0 0 20 20">
    <circle cx="10" cy="10" r="9" />
    <path d="M6 10.5 8.75 13.25 14 7.5" />
  </svg>
{% elsif mark == "no" %}
  <svg class="lp-mark lp-mark--no" role="img" aria-label="No" viewBox="0 0 20 20">
    <circle cx="10" cy="10" r="9" />
    <path d="M7 7l6 6M13 7l-6 6" />
  </svg>
{% elsif mark == "partly" %}
  <svg class="lp-mark lp-mark--partly" role="img" aria-label="Partly" viewBox="0 0 20 20">
    <circle cx="10" cy="10" r="9" />
    <path d="M6.5 10h7" />
  </svg>
{% elsif mark == "lower" %}
  <svg class="lp-mark lp-mark--yes" role="img" aria-label="Lowest price" viewBox="0 0 20 20">
    <circle cx="10" cy="10" r="9" />
    <path d="M10 5.75v8.5M6.5 10.75 10 14.25l3.5-3.5" />
  </svg>
{% elsif mark == "higher" %}
  <svg class="lp-mark lp-mark--no" role="img" aria-label="Higher price" viewBox="0 0 20 20">
    <circle cx="10" cy="10" r="9" />
    <path d="M10 14.25v-8.5M6.5 9.25 10 5.75l3.5 3.5" />
  </svg>
{% endif %}
