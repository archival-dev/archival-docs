{%
  layout 'theme' title: docs.title
  , area: "docs"
  , description: docs.description
  , path: docs.path
  , nofooter: true
%}

<div class="docs-container md:mb-0 md:mt-20 flex flex-1 gap-4 min-h-full w-full md:max-w-[1200px] pt-32">
  <div id="docs-sidebar" class="z-10 w-64 hidden flex-col font-bold md:flex">
    {% for doc in objects.docs %}
      {% assign section_count = doc.sections | size %}
      <div class="side-nav-group flex flex-col">
        <a
          href="/{{doc.path}}.html"
          class="px-4 py-2 my-2 backdrop-blur-md side-nav-item {% if docs.path == doc.path %}side-nav-item-active{% endif %}"
          data-umami-event="docs-sidebar-nav"
          data-umami-event-doc="{{ doc.title }}"
        >
          <h3>{{ doc.title }}</h3>
        </a>
        {% if docs.path == doc.path and section_count > 0 %}
          <ul class="side-nav-sections">
            {% for section in doc.sections %}
              <li>
                <a
                  href="#{{ section.title | url_encode }}"
                  class="side-nav-subitem"
                  data-umami-event="docs-sidebar-section"
                  data-umami-event-section="{{ section.title }}"
                >
                  {{- section.title -}}
                </a>
              </li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>
    {% endfor %}
  </div>

  <div id="docs" class="z-20 w-full min-h-full flex justify-center md:pb-32">
    {% comment %}
      <div id="outline" class="z-30 fixed right-[-180px] hover:right-2 top-20 flex flex-col gap-2 items-end border-gray pr-2 pt-2 w-10 overflow-visible">
      {% for section in docs.sections %}
      <div>
      <a href="#{{section.title | url_encode }}" id="{{section.title | url_encode }}">
      <div class="flex relative w-[200px] justify-between gap-10">
      <div>⸺</div>
      <h2 class="flex-1 self-end">{{ section.title }}</h2>
      </div>
      </a>
      </div>
      {% endfor %}
      </div>
    {% endcomment %}
    <div class="md w-full max-w-screen-md flex flex-col gap-4">
      <h1>{{ docs.title }}</h1>
      {{ docs.description }}

      {% for section in docs.sections %}
        <a
          href="#{{section.title | url_encode }}"
          id="{{section.title | url_encode }}"
          class="docs-section-anchor"
          data-umami-event="docs-section-anchor"
          data-umami-event-section="{{ section.title }}"
        >
          <h2>{{ section.title }}</h2>
        </a>
        {{ section.content }}
      {% endfor %}

      {% if docs.build_cta %}
        <div class="docs-build-cta">
          {% include "build-cta" %}
        </div>
      {% endif %}

      <div class="flex justify-between text-lg font-bold mt-10 gap-5">
        {% assign prev_order = docs.order | minus: 1 %}
        {% assign next_order = docs.order | plus: 1 %}
        {% for doc in objects.docs %}
          {% if doc.order == next_order %}
            {% assign next = doc %}
          {% endif %}
          {% if doc.order == prev_order %}
            {% assign prev = doc %}
          {% endif %}
        {% endfor %}
        {% if prev %}
          <a href="/{{ prev.path }}.html" data-umami-event="docs-prev" data-umami-event-doc="{{ prev.title }}">
            <div id="prev" class="">← {{ prev.title }}</div>
          </a>
        {% else %}
          <div></div>
        {% endif %}
        {% if next %}
          <a href="/{{ next.path }}.html" data-umami-event="docs-next" data-umami-event-doc="{{ next.title }}">
            <div id="next" class="">{{ next.title }} →</div>
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</div>
