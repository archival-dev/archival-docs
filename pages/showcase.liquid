{%
  layout 'theme' title: showcase_page.title
  , area: "showcase"
  , description: showcase_page.tagline
  , path: "showcase"
%}

{% assign sorted_studies = objects.showcase | reverse %}

<div class="updates-page showcase-page">
  <header class="updates-hero showcase-hero">
    <h1 class="hero-message" data-tilt-hero>
      <span class="hero-line-1">built with</span>
      <span class="hero-line-2">archival</span>
    </h1>
    <p class="build-description">
      {{ showcase_page.tagline }}
      <a href="/showcase.rss" data-rybbit-event="showcase-rss-hero">Subscribe with RSS</a>, or follow
      <span class="updates-handle">@showcase@archival.dev</span> from Mastodon.
    </p>
  </header>

  <div class="updates-layout">
    <div class="updates-list showcase-list">
      {% for study in sorted_studies %}
        {% assign study_slug = study.path | split: "/" | last %}
        {% render "showcase-shot", study: study, href: study.path, id: study_slug, eager: forloop.first %}
      {% endfor %}
    </div>

    <nav class="updates-timeline" aria-label="Case studies" data-timeline>
      <div class="updates-timeline-rail">
        <span class="updates-timeline-line" aria-hidden="true"></span>
        <span class="updates-timeline-fill" data-timeline-fill aria-hidden="true"></span>
        <span class="updates-timeline-thumb" data-timeline-thumb aria-hidden="true"></span>
        <ol class="updates-timeline-dots" data-timeline-dots>
          {% for study in sorted_studies %}
            {% assign study_slug = study.path | split: "/" | last %}
            <li class="updates-timeline-item" data-timeline-item data-timeline-target="{{ study_slug }}">
              <a class="updates-timeline-dot" href="#{{ study_slug }}">
                <span class="updates-timeline-mark" aria-hidden="true"></span>
                <span class="updates-timeline-label">
                  <span class="updates-timeline-title">{{ study.site_name }}</span>
                </span>
              </a>
            </li>
          {% endfor %}
        </ol>
      </div>
    </nav>
  </div>
</div>
