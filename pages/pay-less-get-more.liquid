{%
  layout 'landing' title: pay_less_get_more.title
  , description: pay_less_get_more.description
  , path: "pay-less-get-more"
  , nav_cta_label: pay_less_get_more.cta_label
%}

{% assign lp = objects.pay_less_get_more %}

{% comment %}
  Google Ads landing page. Its own words come from the pay_less_get_more
  object; the comparison, the template catalog and the shared questions from
  landing_shared, which the trade pages read too. The frames are the
  homepage's product tour partial and the cards under them its benefit cards.
  Every CTA, the nav's included, reports cta_click to Rybbit with this page's
  name and its own label; a template card reports its template's name.

  The template cards come straight after the hero, then the comparison, so a
  visitor sees what they would be building before what it costs.
{% endcomment %}

{% include "lp-hero",
  headline: lp.headline,
  subhead: lp.subhead,
  cta_label: lp.cta_label,
  link_label: lp.templates_link_label,
  lp_page: "pay-less-get-more"
%}

{% include "lp-templates", cards: lp.templates, intro: lp.templates_intro, lp_page: "pay-less-get-more" %}

{% include "lp-compare" %}

<section class="lp-features" aria-labelledby="features-title">
  <h2 class="section-title lp-section-title" id="features-title">{{ lp.features_title }}</h2>
  <p class="lp-section-intro">{{ lp.features_intro }}</p>
  {% include "product-tour", sections: lp.features, mode_callout: lp.mode_callout %}

  <div class="benefit-grid benefit-grid--compact lp-benefits">
    {% for benefit in lp.benefits %}
      <div class="benefit" data-glow>
        <h3 class="section-title">{{ benefit.title }}</h3>
        <div class="section-content">{{ benefit.content }}</div>
      </div>
    {% endfor %}
  </div>
</section>

{% include "lp-faq", title: lp.faq_title, items: lp.faq %}

{% include "lp-final",
  headline: lp.headline,
  line: lp.final_line,
  cta_label: lp.cta_label,
  lp_page: "pay-less-get-more"
%}

{% include "lp-glow" %}
