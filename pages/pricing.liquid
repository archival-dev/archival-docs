{%
  layout 'theme' title: "Pricing"
  , area: "pricing"
  , description: pricing.tagline
  , path: "pricing"
%}

{% assign pricing = objects.pricing %}

<div class="pricing-page">
  <section class="pricing-hero">
    <div class="pricing-hero-content">
      <h1 class="hero-message pricing-title" data-tilt-hero>
        <span class="pricing-title-line">{{ pricing.title_line_1 }}</span>
        <span class="pricing-title-line pricing-title-line-secondary">{{ pricing.title_line_2 }}</span>
      </h1>
      <p class="pricing-tagline">{{ pricing.tagline }}</p>
    </div>

    <div class="pricing-tiers">
      {% for tier in pricing.tiers %}
        <div
          class="pricing-tier{% if tier.featured %} pricing-tier-featured glow-container{% endif %}"
          data-tier="{{ tier.slug }}"
        >
          {% if tier.featured %}
            <div class="glowverlay showing"></div>
          {% endif %}
          <div class="pricing-tier-content">
            <div class="pricing-tier-icon">
              {% case tier.icon %}
                {% when "terminal" %}
                  <svg
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path
                      d="M4 17L10 11L4 5"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round" />
                    <path
                      d="M12 19H20"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round" />
                  </svg>
                {% when "pencil" %}
                  <svg
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path
                      d="M12 20H21"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round" />
                    <path
                      d="M16.5 3.5C16.8978 3.10218 17.4374 2.87868 18 2.87868C18.5626 2.87868 19.1022 3.10218 19.5 3.5C19.8978 3.89782 20.1213 4.43739 20.1213 5C20.1213 5.56261 19.8978 6.10218 19.5 6.5L7 19L3 20L4 16L16.5 3.5Z"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round" />
                  </svg>
                {% when "diamond" %}
                  {% comment %}
                    Filled icon, unlike the stroked terminal/pencil above. The
                    artwork runs edge to edge of its 24pt box while those inset
                    to ~2pt, so the viewBox is padded to -2 -2 28 28 to match
                    their optical size.
                  {% endcomment %}
                  <svg
                    width="24"
                    height="24"
                    viewBox="-2 -2 28 28"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path
                      d="M4.58312 0.325682L0.124411 7.53176C-0.0567843 7.82421 -0.0379891 8.2627 0.167283 8.5326L11.4855 23.7454C11.7421 24.0849 12.2579 24.0849 12.5145 23.7454L23.8327 8.5326C24.038 8.2627 24.0568 7.82421 23.8756 7.53176L19.4169 0.325682C19.2888 0.123191 19.0751 -0.00155446 18.8595 0.000407193H5.14045C4.89883 -0.00880058 4.69678 0.139324 4.58312 0.325682ZM6.11581 1.60176H10.6388L7.61634 6.39332L6.11581 1.60176ZM13.3612 1.60176H17.8842L16.3837 6.39332L13.3612 1.60176ZM12 2.16471L15.194 7.20649H8.81676L12 2.16471ZM4.93679 2.4775L6.41592 7.20649H2.01079L4.93679 2.4775ZM19.0632 2.4775L21.9892 7.20649H17.5841L19.0632 2.4775ZM2.18227 8.80784H6.90891L10.3173 19.742L2.18227 8.80784ZM8.36657 8.80784H15.6441L12 20.4802L8.36657 8.80784ZM17.0911 8.80784H21.8177L13.6827 19.742L17.0911 8.80784Z"
                      fill="currentColor" />
                  </svg>
              {% endcase %}
            </div>

            <h2 class="pricing-tier-name">{{ tier.name }}</h2>
            <p class="pricing-tier-audience">{{ tier.audience }}</p>

            <div class="pricing-tier-price">
              <span class="pricing-tier-price-amount">{{ tier.price }}</span>
              <span class="pricing-tier-price-term">{{ tier.term }}</span>
            </div>

            <div class="pricing-tier-features">{{ tier.features }}</div>

            <a
              class="pricing-cta {% if tier.cta_url contains 'mailto:' %}pricing-cta-secondary{% else %}primary-cta{% endif %}"
              href="{{ tier.cta_url }}"
              data-umami-event="pricing-cta-{{ tier.slug }}"
            >
              {{- tier.cta_label -}}
            </a>
          </div>
        </div>
      {% endfor %}
    </div>

    {% if pricing.usage_limits %}
      <button
        type="button"
        class="pricing-limits-trigger"
        popovertarget="pricing-limits"
        data-umami-event="pricing-limits"
      >
        Usage limits
      </button>
      <div id="pricing-limits" class="pricing-limits-popover" popover>
        <div class="pricing-limits-header">
          <h2 class="pricing-limits-title">Usage limits</h2>
          <button
            type="button"
            class="pricing-limits-close"
            popovertarget="pricing-limits"
            popovertargetaction="hide"
            aria-label="Close"
          >
            &times;
          </button>
        </div>
        <div class="pricing-limits-body">{{ pricing.usage_limits }}</div>
      </div>
    {% endif %}
  </section>
</div>
