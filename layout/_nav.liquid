<nav
  id="nav"
  role="nav"
  class="z-50 w-full py-5 fixed flex justify-between font-bold gap-4 backdrop-blur-md bottom-auto top-0 shadow-lg inset-x-0"
>
  <div id="logo" class="">
    <a href="/" class="flex gap-2 items-center" data-umami-event="nav-logo">
      <div class="logo-icon w-[179px] h-[33px] relative">
        <div class="gray">
          {% include "logo-svg-2", size: "32" %}
        </div>
      </div>
    </a>
  </div>
  <div class="flex-1 justify-end md:justify-center flex hidden">
    <button
      id="quick-search-button"
      class="flex gap-4 font-light text-sm items-center text-gray-dark md:border md:opacity-60 md:border-gray md:bg-white md:rounded-lg md:px-2"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="3"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="feather feather-search"
      >
        <circle
          cx="11"
          cy="11"
          r="8"></circle>
        <line
          x1="21"
          y1="21"
          x2="16.65"
          y2="16.65"></line>
      </svg>
      <div class="hidden md:flex">Quick Search...</div>
      <div class="hidden md:flex">⌘K</div>
    </button>
  </div>
  <ul class="flex-shrink justify-end gap-8 items-center flex-nowrap whitespace-nowrap hidden navbar:flex">
    {% comment %}
      The tour lives on the homepage now, so this item has no page of its own to
      match on. index.liquid scroll-spies it instead: active while the tour is
      actually on screen. Desktop only — the mobile item sits in a closed menu,
      where an active state has nothing to tell anyone.
    {% endcomment %}
    <li class="nav-text" data-nav-product>
      {% comment %}
        Bare "#product" on the homepage itself. "/#product" is a different
        document from "/index.html", so the browser reloads the whole page and
        only then jumps — which reads as a long stall followed by a snap.
      {% endcomment %}
      <a
        href="{% if area == 'home' %}#product{% else %}/#product{% endif %}"
        data-umami-event="nav-product"
        >Product</a
      >
    </li>
    {% assign docs_link = objects.docs | first %}
    <li class="nav-text {% if area == 'docs' %}nav-active{% endif %}">
      <a href="/{{ docs_link.path }}.html" data-umami-event="nav-docs">Docs</a>
    </li>
    {% assign cli_link = objects.cli | first %}
    <li class="nav-text {% if area == 'cli' %}nav-active{% endif %}">
      <a href="/{{ cli_link.path }}.html" data-umami-event="nav-cli">CLI</a>
    </li>
    <li class="nav-text {% if area == 'updates' %}nav-active{% endif %}">
      <a href="/updates.html" data-umami-event="nav-updates">Updates</a>
    </li>
    {% comment %} <li class="nav-text {% if area == 'manifesto' %}nav-active{% endif %}">
      <a href="/manifesto.html" data-umami-event="nav-manifesto">Manifesto</a>
    </li> {% endcomment %}
    <li class="nav-text {% if area == 'pricing' %}nav-active{% endif %}">
      <a href="/pricing.html" data-umami-event="nav-pricing">Pricing</a>
    </li>
    <li class="nav-text">
      <a href="https://editor.archival.dev" data-umami-event="nav-dashboard">Dashboard</a>
    </li>
    <li class="nav-text-cta">
      <a href="https://editor.archival.dev/new" data-umami-event="nav-create">Create</a>
    </li>
  </ul>
  <div class="navbar:hidden flex items-center">
    <button>
      <div id="menu-closed">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="3"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="feather feather-menu"
        >
          <line
            x1="3"
            y1="12"
            x2="21"
            y2="12"></line>
          <line
            x1="3"
            y1="6"
            x2="21"
            y2="6"></line>
          <line
            x1="3"
            y1="18"
            x2="21"
            y2="18"></line>
        </svg>
      </div>
      <div id="menu-open" class="hidden">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="3"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="feather feather-x"
        >
          <line
            x1="18"
            y1="6"
            x2="6"
            y2="18"></line>
          <line
            x1="6"
            y1="6"
            x2="18"
            y2="18"></line>
        </svg>
      </div>
    </button>
  </div>
</nav>
<div
  id="mobile-menu"
  class="hidden fixed backdrop-blur-md translate-y-full transition opacity-0 shadow-up w-full pb-10 px-4 bottom-0 z-40 text-xl rounded-lg navbar:hidden max-h-full overflow-y-auto"
>
  <ul class="flex flex-col">
    <li class="mobile-nav-item">
      <a
        class="flex-1"
        href="{% if area == 'home' %}#product{% else %}/#product{% endif %}"
        data-umami-event="mobile-nav-product"
        >Product</a
      >
    </li>
    {% assign docs_link = objects.docs | first %}
    <li class="mobile-nav-item">
      <a class="flex-1" href="/{{ docs_link.path }}.html" data-umami-event="mobile-nav-docs">Docs</a>
    </li>
    {% assign cli_link = objects.cli | first %}
    <li class="mobile-nav-item">
      <a class="flex-1" href="/{{ cli_link.path }}.html" data-umami-event="mobile-nav-cli">CLI</a>
    </li>
    <li class="mobile-nav-item">
      <a class="flex-1" href="/updates.html" data-umami-event="mobile-nav-updates">Updates</a>
    </li>
    <li class="mobile-nav-item">
      <a class="flex-1" href="/manifesto.html" data-umami-event="mobile-nav-manifesto">Manifesto</a>
    </li>
    <li class="mobile-nav-item">
      <a class="flex-1" href="/pricing.html" data-umami-event="mobile-nav-pricing">Pricing</a>
    </li>
    <li class="mobile-nav-item">
      <a class="flex-1" href="https://editor.archival.dev" data-umami-event="mobile-nav-dashboard">Editor</a>
    </li>
    <li class="mobile-nav-item mobile-nav-item-cta">
      <a class="flex-1" href="https://editor.archival.dev/new" data-umami-event="mobile-nav-create">Create</a>
    </li>
  </ul>
</div>

{% if area == "docs" or area == "cli" %}
  <div
    id="docs-nav"
    class="hidden z-[51] w-full py-5 fixed flex justify-between font-bold gap-4 backdrop-blur-md bottom-0 top-auto shadow-lg max-w-[1200px] mx-auto inset-x-0"
  >
    {% if area == "docs" %}
      {% assign other_pages = objects.docs %}
      {% assign order = docs.order | round %}
    {% elsif area == "cli" %}
      {% assign other_pages = objects.cli %}
      {% assign order = cli.order | round %}
    {% endif %}
    {% if order > 0 %}
      {% assign prev_index = order | minus: 1 %}
      {% assign prev_page = other_pages | slice: prev_index | first %}
      {% assign prev_link = prev_page.path | append: ".html" %}
    {% endif %}
    {% assign max_order = other_pages | size | minus: 1 %}
    {% if order < max_order %}
      {% assign next_index = order | plus: 1 %}
      {% assign next_page = other_pages | slice: next_index | first %}
      {% assign next_link = next_page.path | append: ".html" %}
    {% endif %}
    <a
      {% if prev_link %}
        href="/{{ prev_link }}"
      {% endif %}
    >
      <div class="nav-left{% unless prev_link %} nav-disabled{% endunless %}"></div>
    </a>
    <div id="mobile-current-view" class="docs-current-view cursor-pointer select-none">
      {% if area == "docs" %}
        {{ docs.title }}
      {% else %}
        {{ cli.command }}
      {% endif %}
    </div>
    <a
      {% if next_link %}
        href="/{{ next_link }}"
      {% endif %}
    >
      <div class="nav-right{% unless next_link %} nav-disabled{% endunless %}"></div>
    </a>
  </div>
  <div
    id="docs-selector"
    class="transition translate-y-full opacity-0 pointer-events-none [&.showing]:pointer-events-auto [&.showing]:opacity-100 [&.showing]:translate-y-0 z-50 w-full py-5 fixed flex justify-between font-bold gap-4 backdrop-blur-md bottom-16 top-auto shadow-lg max-w-[1200px] mx-auto inset-x-0 max-h-[70vh] overflow-y-auto"
  >
    {% assign current_path = "" %}
    {% if area == "docs" %}
      {% assign current_path = docs.path %}
    {% else %}
      {% assign current_path = cli.path %}
    {% endif %}
    {% if area == "docs" %}
      <ul class="flex flex-col w-full">
        {% for doc in objects.docs %}
          {% assign section_count = doc.sections | size %}
          <li class="flex flex-col">
            <div class="flex px-8 py-3 text-center {% if current_path == doc.path %}nav-active{% endif %}">
              <a class="flex-1" href="/{{ doc.path }}.html">{{ doc.title }}</a>
            </div>
            {% if current_path == doc.path and section_count > 0 %}
              <ul class="mobile-nav-sections">
                {% for section in doc.sections %}
                  <li>
                    <a class="mobile-nav-subitem" href="#{{ section.title | url_encode }}">{{ section.title }}</a>
                  </li>
                {% endfor %}
              </ul>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    {% elsif area == "cli" %}
      <ul class="flex flex-col w-full">
        {% for doc in objects.cli %}
          <li class="flex px-8 py-3 text-center">
            <a class="flex-1" href="/{{ doc.path }}.html">{{ doc.command }}</a>
          </li>
        {% endfor %}
      </ul>
    {% endif %}
  </div>
{% endif %}
<div class="modal-backdrop hidden"></div>
