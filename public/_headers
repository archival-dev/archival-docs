# Feed readers need an RSS content type, and the static host can't infer one
# from the .rss extension.
/updates.rss
    Content-Type: application/rss+xml; charset=utf-8
    Cache-Control: public, max-age=3600
    X-Robots-Tag: noindex

/showcase.rss
    Content-Type: application/rss+xml; charset=utf-8
    Cache-Control: public, max-age=3600
    X-Robots-Tag: noindex

# Apple requires this file be served as JSON, and it has no extension for the
# static host to infer that from.
/.well-known/apple-app-site-association
    Content-Type: application/json

# SchemaStore's catalog points at these URLs, so editors and language servers
# fetch them, including browser-based ones (Monaco in the archival editor) that
# are subject to CORS.
/schemas/*
    Access-Control-Allow-Origin: *
    Cache-Control: public, max-age=3600
    X-Robots-Tag: noindex

# Machine-readable copies of the docs; the HTML pages are the ones to index.
/llms.txt
    X-Robots-Tag: noindex
/docs/llms.txt
    X-Robots-Tag: noindex
/api/*
    X-Robots-Tag: noindex
/agent/*
    X-Robots-Tag: noindex
