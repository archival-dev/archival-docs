# Feed readers reject a feed served as text/plain or application/octet-stream,
# which is what a host that doesn't know the .rss extension will guess.
/updates.rss
    Content-Type: application/rss+xml; charset=utf-8
    Cache-Control: public, max-age=3600

# Apple requires this file be served as JSON, and it has no extension for the
# static host to infer that from.
/.well-known/apple-app-site-association
    Content-Type: application/json

# These are the URLs SchemaStore's catalog points at, so they are fetched by
# editors and language servers rather than by this site. Browser-based ones
# (Monaco in the archival editor, anything running in a page) are subject to
# CORS, and a schema that fails to load just leaves the user with no
# autocompletion and no error - so allow any origin.
/schemas/*
    Access-Control-Allow-Origin: *
    Cache-Control: public, max-age=3600
