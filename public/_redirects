# The product tour merged into the homepage. Keep both spellings of the old URL
# alive so inbound links and the previous nav target land on the tour in place.
/product.html    /#product    301
/product         /#product    301

# The short address for the MCP server, which is served by the api worker. 308
# rather than 301/302: MCP is a POST protocol and most clients rewrite a
# redirected POST into a GET, which would break every install that typed this.
/mcp    https://api.archival.dev/mcp    308

# Docs and CLI pages are rendered per object, so the section roots have no page
# of their own. Keep these pointed at the lowest-order object of each type.
/docs         /docs/getting-started    301
/docs/        /docs/getting-started    301
/docs.html    /docs/getting-started    301
/cli          /cli/build               301
/cli/         /cli/build               301
/cli.html     /cli/build               301
