{
  "compilerOptions": {
    /* Basic Options */
    "target": "esnext" /* Specify ECMAScript target version: 'ES3' (default), 'ES5', 'ES2015', 'ES2016', 'ES2017','ES2018' or 'ESNEXT'. */,
    "module": "nodenext" /* Specify module code generation: 'none', 'commonjs', 'amd', 'system', 'umd', 'es2015', or 'ESNext'. */,
    "lib": ["esnext", "dom"],
    "isolatedModules": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    /* Module Resolution Options */
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    /* Experimental Options */
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "paths": {
      "three/addons/loaders/*": [
        "./node_modules/@types/three/examples/jsm/loaders/*"
      ],
      "three/addons/math/*": ["./node_modules/@types/three/examples/jsm/math/*"]
    },
  },
  "include": ["define.d.ts", "src"]
}
